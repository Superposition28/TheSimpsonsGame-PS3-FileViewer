<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TheSimpsonsGame.FileViewer.UI.SettingsWindow"
        Title="Connections Settings" Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <!-- Fields -->
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="Connections Server Settings" FontWeight="Bold" FontSize="16" Foreground="#E0E0E0"/>

            <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                <!-- Port -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server Port:" VerticalAlignment="Center" Foreground="#B0BEC5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPort" Text="8781" Margin="4,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="(0 for random port)" VerticalAlignment="Center" Margin="8,0" Foreground="#808080" FontSize="11"/>

                <!-- Source Root -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Source Root:" VerticalAlignment="Center" Foreground="#B0BEC5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSource" Margin="4,2"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." x:Name="BtnBrowseSource" Click="OnBrowseSourceClick" Margin="4,2"/>

                <!-- Database Path -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Database (SQLite):" VerticalAlignment="Center" Foreground="#B0BEC5"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDatabase" Margin="4,2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." x:Name="BtnBrowseDatabase" Click="OnBrowseDatabaseClick" Margin="4,2"/>

                <!-- Extracted Roots -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Extracted Root(s):" VerticalAlignment="Center" Foreground="#B0BEC5"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtExtracted" Margin="4,2"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="(Semicolon separated)" VerticalAlignment="Center" Margin="8,0" Foreground="#808080" FontSize="11"/>
            </Grid>

            <Separator Background="#333333" Margin="0,8"/>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Rebuild Connections Database" x:Name="BtnRebuild" Click="OnRebuildClick" Background="#2E7D32" Foreground="White"/>
                <TextBlock DockPanel.Dock="Right" x:Name="LblBuildStatus" Text="Ready" VerticalAlignment="Center" Foreground="#90CAF9"/>
            </DockPanel>
        </StackPanel>

        <!-- Build Log -->
        <Border Grid.Row="1" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Margin="0,10">
            <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas, monospace" FontSize="11" Background="Transparent" BorderThickness="0"
                     Foreground="#A0A0A0"/>
        </Border>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Save &amp; Close" x:Name="BtnSave" Click="OnSaveClick" Background="#1976D2" Foreground="White" Width="110"/>
            <Button Content="Cancel" x:Name="BtnCancel" Click="OnCancelClick" Width="80"/>
        </StackPanel>
    </Grid>
</Window>

